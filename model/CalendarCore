package calendar.model;

import java.time.DayOfWeek;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.List;
import java.util.Objects;
import java.util.UUID;

/**
 * Core implementation for managing events in a single calendar with comprehensive CRUD operations.
 * This class provides the fundamental event management functionality including creation,
 * modification, deletion, and querying of both single events and recurring series.
 * Events are stored in memory and identified by their subject, start time, and end time.
 * Key features include duplicate prevention, time validation, recurring series generation,
 * and flexible event editing capabilities. All-day events are supported by setting the
 * end time to null, with a default end time of 5 PM for query operations.
 */
public class CalendarCore implements CalendarModel {

  // Internal storage for all calendar events
  private final List<CalendarEvent> eventList = new ArrayList<>();

  /**
   * Returns all events whose start date matches the given date.
   * This method is used primarily by test classes to access the underlying
   * CalendarEvent objects directly. For general use, prefer getEventsOnDate().
   *
   * @param date the date to match against event start dates
   * @return list of CalendarEvent objects starting on the specified date
   */
  public List<CalendarEvent> getCalendarEventsOnDate(LocalDate date) {
    List<CalendarEvent> results = new ArrayList<>();
    for (CalendarEvent e : eventList) {
      if (e.getStart().toLocalDate().equals(date)) {
        results.add(e);
      }
    }
    return results;
  }

  /**
   * Returns all events that overlap with the given date-time range.
   * Finds events that have any temporal intersection with the specified range.
   * For all-day events (null end time), assumes they end at 5 PM on the start date.
   * This method provides direct access to CalendarEvent objects for testing purposes.
   *
   * @param rangeStart inclusive start of the query range
   * @param rangeEnd   inclusive end of the query range
   * @return list of CalendarEvent objects overlapping the range
   * @throws IllegalArgumentException if rangeEnd is before rangeStart
   */
  public List<CalendarEvent> getCalendarEventsBetween(
      LocalDateTime rangeStart,
      LocalDateTime rangeEnd
  ) {
    if (rangeEnd.isBefore(rangeStart)) {
      throw new IllegalArgumentException("start must be before end");
    }

    List<CalendarEvent> results = new ArrayList<>();
    for (CalendarEvent e : eventList) {
      LocalDateTime st = e.getStart();
      // Default end time for all-day events is 5 PM on the start date
      LocalDateTime en = (e.getEnd() == null)
          ? st.withHour(17).withMinute(0)
          : e.getEnd();

      // Check for temporal overlap: events overlap if they don't end before range starts
      // or start after range ends
      if (!(en.isBefore(rangeStart) || st.isAfter(rangeEnd))) {
        results.add(e);
      }
    }
    return results;
  }

  @Override
  public List<Event> getEventsOnDate(LocalDate date) {
    return new ArrayList<>(getCalendarEventsOnDate(date));
  }

  @Override
  public List<Event> getEventsBetween(LocalDateTime from, LocalDateTime to) {
    return new ArrayList<>(getCalendarEventsBetween(from, to));
  }

  @Override
  public boolean isBusyAt(LocalDateTime timestamp) {
    for (CalendarEvent e : eventList) {
      LocalDateTime st = e.getStart();
      // Default end time for all-day events is 5 PM
      LocalDateTime en = (e.getEnd() == null)
          ? st.withHour(17).withMinute(0)
          : e.getEnd();

      // Check if timestamp falls within event duration (end time is exclusive)
      if (!timestamp.isBefore(st) && timestamp.isBefore(en)) {
        return true;
      }
    }
    return false;
  }

  @Override
  public void addEvent(
      String subject,
      LocalDateTime start,
      LocalDateTime end,
      String description,
      String location,
      String status
  ) {
    // Validate required parameters
    if (subject == null) {
      throw new IllegalArgumentException("subject cannot be null");
    }

    // Ensure logical time ordering
    if (end != null && end.isBefore(start)) {
      throw new IllegalArgumentException("start must be before end");
    }

    // Create new event instance
    CalendarEvent ev = new CalendarEvent(
        subject, start, end, description, location, status
    );

    // Prevent duplicate events (identified by subject, start, and end times)
    if (eventList.contains(ev)) {
      throw new IllegalArgumentException(
          "Duplicate event: subject=" + subject
              + ", start=" + start
              + ", end=" + end
      );
    }

    eventList.add(ev);
  }

  @Override
  public void addRecurringSeries(
      String subject,
      LocalDateTime firstStart,
      LocalDateTime firstEnd,
      List<DayOfWeek> weekdays,
      int occurrences,
      LocalDate untilDate,
      String description,
      String location,
      String status
  ) {
    // Validate input parameters
    if (weekdays == null || weekdays.isEmpty()) {
      throw new IllegalArgumentException("weekdays cannot be empty");
    }
    if (occurrences > 0 && untilDate != null) {
      throw new IllegalArgumentException(
          "Specify either count or untilDate, not both"
      );
    }
    if (occurrences <= 0 && untilDate == null) {
      throw new IllegalArgumentException(
          "Either occurrences must be > 0 or untilDate must be non-null."
      );
    }

    // Generate unique series identifier for all events in this series
    String seriesId = UUID.randomUUID().toString();
    int created = 0;
    LocalDateTime candidate = firstStart;

    // Generate recurring events by iterating through dates
    while (true) {
      // Check if current date matches one of the specified weekdays
      if (weekdays.contains(candidate.getDayOfWeek())) {
        // Calculate end time for this occurrence, preserving time-of-day from first event
        LocalDateTime occEnd = (firstEnd == null)
            ? null
            : LocalDateTime.of(candidate.toLocalDate(), firstEnd.toLocalTime());

        // Create event occurrence with series identifier
        CalendarEvent ev = new CalendarEvent(
            subject, candidate, occEnd,
            description, location, status, seriesId
        );

        // Check for conflicts with existing events
        if (eventList.contains(ev)) {
          throw new IllegalArgumentException(
              "Recurring series conflict at " + candidate
          );
        }

        eventList.add(ev);
        created++;

        // Check if we've reached the occurrence limit
        if (occurrences > 0 && created >= occurrences) {
          break;
        }
      }

      // Move to next day
      candidate = candidate.plusDays(1);

      // Check if we've passed the end date
      if (untilDate != null && candidate.toLocalDate().isAfter(untilDate)) {
        break;
      }
    }
  }

  @Override
  public Event findEvent(String subject,
                         LocalDateTime start,
                         LocalDateTime end) {
    // Search for event matching all identifying characteristics
    for (CalendarEvent e : eventList) {
      if (!e.getSubject().equals(subject)) {
        continue;
      }
      if (!e.getStart().equals(start)) {
        continue;
      }
      if (end != null && !Objects.equals(e.getEnd(), end)) {
        continue;
      }
      return e;
    }
    return null;
  }

  @Override
  public void editSingleEvent(
      Event eventToEdit,
      String newSubject,
      LocalDateTime newStart,
      LocalDateTime newEnd,
      String newDescription,
      String newLocation,
      String newStatus
  ) {
    // Validate event type and existence
    if (!(eventToEdit instanceof CalendarEvent)) {
      throw new IllegalArgumentException("Event not found.");
    }

    // Subject is required - cannot be null
    if (newSubject == null) {
      throw new IllegalArgumentException("subject cannot be null");
    }

    CalendarEvent existing = (CalendarEvent) eventToEdit;

    // Determine proposed new values (keep existing if null provided)
    LocalDateTime proposedStart = (newStart != null)
        ? newStart : existing.getStart();
    LocalDateTime proposedEnd = (newEnd != null)
        ? newEnd : existing.getEnd();

    // Validate time ordering
    if (proposedEnd != null && proposedEnd.isBefore(proposedStart)) {
      throw new IllegalArgumentException("start must be before end");
    }

    // Check for duplicate conflicts after edit
    // Create a temporary event with proposed changes to test for duplicates
    CalendarEvent candidate = new CalendarEvent(
        newSubject,
        proposedStart,
        proposedEnd,
        existing.getDescription(),
        existing.getLocation(),
        existing.getStatus()
    );

    // Ensure no other event would have the same identifying characteristics
    for (CalendarEvent other : eventList) {
      if (other.equals(candidate)
          && !other.getId().equals(existing.getId())) {
        throw new IllegalArgumentException("Duplicate would result after edit.");
      }
    }

    // Apply all changes to the existing event
    existing.setSubject(newSubject);
    if (newStart != null)       {
      existing.setStart(newStart);
    }
    if (newEnd != null)         {
      existing.setEnd(newEnd);
    }
    if (newDescription != null) {
      existing.setDescription(newDescription);
    }
    if (newLocation != null)    {
      existing.setLocation(newLocation);
    }
    if (newStatus != null)      {
      existing.setStatus(newStatus);
    }
  }

  @Override
  public void editSeriesFrom(
      Event ev,
      String ns,
      LocalDateTime s,
      LocalDateTime e,
      String d,
      String l,
      String st
  ) {
    editSingleEvent(ev, ns, s, e, d, l, st);
  }

  @Override
  public void editSeriesAll(
      Event ev,
      String ns,
      LocalDateTime s,
      LocalDateTime e,
      String d,
      String l,
      String st
  ) {
    editSingleEvent(ev, ns, s, e, d, l, st);
  }

  @Override
  public void removeSingleEvent(Event ev) {
    // Remove event if it's a CalendarEvent instance
    if (ev instanceof CalendarEvent) {
      eventList.remove(ev);
    }
  }
}
