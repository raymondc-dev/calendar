import org.junit.Test;

import java.time.LocalDateTime;

import calendar.model.CalendarEvent;

import static org.junit.Assert.assertTrue;
import static org.junit.Assert.assertThrows;
import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNotEquals;
import static org.junit.Assert.assertNull;

/**
 * Unit tests for the CalendarEvent class covering construction, validation, and modification.
 * This test suite verifies the core functionality of CalendarEvent including:
 * - Constructor validation with proper time ordering
 * - Support for both timed and all-day events
 * - Equality and hash code implementation based on logical identity
 * - Mutable property updates with validation
 * - String representation formatting
 * - Error handling for invalid operations
 * Tests ensure that events maintain data integrity through validation of time relationships,
 * proper handling of null values for all-day events, and consistent equality semantics
 * based on subject, start time, and end time.
 */
public class CalendarEventTest {

  @Test
  public void constructor_validTimedEvent_succeeds() {
    LocalDateTime start = LocalDateTime.of(2025, 6, 1, 10, 0);
    LocalDateTime end   = LocalDateTime.of(2025, 6, 1, 11, 0);

    CalendarEvent event = new CalendarEvent(
        "TeamMeeting",
        start,
        end,
        "Discuss roadmap",
        "ConferenceRoom",
        "public"
    );

    assertEquals("TeamMeeting", event.getSubject());
    assertEquals(start, event.getStart());
    assertEquals(end, event.getEnd());
    assertEquals("Discuss roadmap", event.getDescription());
    assertEquals("ConferenceRoom", event.getLocation());
    assertEquals("public", event.getStatus());
    assertNull(event.getSeriesId());
  }

  @Test
  public void constructor_endBeforeStart_throwsException() {
    LocalDateTime start = LocalDateTime.of(2025, 6, 1, 12, 0);
    LocalDateTime end   = LocalDateTime.of(2025, 6, 1, 11, 0);

    // Now expecting IllegalArgumentException from validateTimes()
    IllegalArgumentException ex = assertThrows(
        IllegalArgumentException.class,
        () -> new CalendarEvent(
            "InvalidEvent",
            start,
            end,
            null,
            null,
            "private"
        )
    );
    assertTrue(ex.getMessage().contains("End time must be ≥ start time"));
  }

  @Test
  public void constructor_allDayEvent_endIsNull_succeeds() {
    LocalDateTime start = LocalDateTime.of(2025, 7, 4, 0, 0);

    CalendarEvent event = new CalendarEvent(
        "IndependenceDay",
        start,
        null,
        null,
        "Nationwide",
        "public"
    );

    assertEquals(start, event.getStart());
    assertNull(event.getEnd());
    String repr = event.toString();
    assertTrue(repr.contains("IndependenceDay"));
    assertTrue(repr.contains("(all-day)"));
  }

  @Test
  public void equalsAndHashCode_sameSubjectStartEnd_areEqual() {
    LocalDateTime start = LocalDateTime.of(2025, 8, 1, 9, 0);
    LocalDateTime end   = LocalDateTime.of(2025, 8, 1, 10, 0);

    CalendarEvent a = new CalendarEvent(
        "DailyStandup", start, end, null, null, "public"
    );
    CalendarEvent b = new CalendarEvent(
        "DailyStandup", start, end, "desc", "loc", "private"
    );

    assertEquals(a, b);
    assertEquals(a.hashCode(), b.hashCode());
  }

  @Test
  public void equals_differentSubjectNotEqual() {
    LocalDateTime start = LocalDateTime.of(2025, 8, 1, 9, 0);
    LocalDateTime end   = LocalDateTime.of(2025, 8, 1, 10, 0);

    CalendarEvent a = new CalendarEvent("EventA", start, end, null, null, "public");
    CalendarEvent b = new CalendarEvent("EventB", start, end, null, null, "public");

    assertNotEquals(a, b);
  }

  @Test
  public void equals_differentStartNotEqual() {
    LocalDateTime startA = LocalDateTime.of(2025, 8, 1, 9, 0);
    LocalDateTime endA   = LocalDateTime.of(2025, 8, 1, 10, 0);
    LocalDateTime startB = LocalDateTime.of(2025, 8, 1, 11, 0);
    LocalDateTime endB   = LocalDateTime.of(2025, 8, 1, 12, 0);

    CalendarEvent a = new CalendarEvent("Event", startA, endA, null, null, "public");
    CalendarEvent b = new CalendarEvent("Event", startB, endB, null, null, "public");

    assertNotEquals(a, b);
  }

  @Test
  public void toString_timedEvent_hasProperFormat() {
    LocalDateTime start = LocalDateTime.of(2025, 9, 1, 14, 30);
    LocalDateTime end   = LocalDateTime.of(2025, 9, 1, 15, 45);

    CalendarEvent event = new CalendarEvent(
        "Presentation", start, end, null, null, "public"
    );
    String repr = event.toString();
    assertTrue(repr.contains("Presentation"));
    assertTrue(repr.contains("2025-09-01T14:30"));
    assertTrue(repr.contains("→ 2025-09-01T15:45"));
  }

  @Test
  public void toString_allDayEvent_includesAllDayTag() {
    LocalDateTime start = LocalDateTime.of(2025, 10, 31, 0, 0);
    CalendarEvent event = new CalendarEvent(
        "Halloween", start, null, null, null, "public"
    );
    String repr = event.toString();
    assertTrue(repr.contains("Halloween"));
    assertTrue(repr.contains("(all-day)"));
  }

  @Test
  public void setters_updateFields_andValidate() {
    LocalDateTime start = LocalDateTime.of(2025, 11, 1, 8, 0);
    LocalDateTime end   = LocalDateTime.of(2025, 11, 1, 9, 0);
    CalendarEvent event = new CalendarEvent(
        "MorningMeeting", start, end, "Desc", "Office", "private"
    );

    // subject, desc, loc, status
    event.setSubject("NewSubject");
    assertEquals("NewSubject", event.getSubject());

    event.setDescription("NewDesc");
    assertEquals("NewDesc", event.getDescription());

    event.setLocation("ConferenceRoom");
    assertEquals("ConferenceRoom", event.getLocation());

    event.setStatus("public");
    assertEquals("public", event.getStatus());

    // start and end valid adjustments
    LocalDateTime newStart = LocalDateTime.of(2025, 11, 1, 7, 30);
    event.setStart(newStart);
    assertEquals(newStart, event.getStart());

    LocalDateTime newEnd = LocalDateTime.of(2025, 11, 1, 8, 30);
    event.setEnd(newEnd);
    assertEquals(newEnd, event.getEnd());

    // invalid: end before start
    LocalDateTime invalidEnd = LocalDateTime.of(2025, 11, 1, 7, 0);
    IllegalArgumentException ex = assertThrows(
        IllegalArgumentException.class,
        () -> event.setEnd(invalidEnd)
    );
    assertTrue(ex.getMessage().contains("End time must be ≥ start time"));
  }
}
