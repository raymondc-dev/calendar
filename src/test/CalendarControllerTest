import calendar.controller.CalendarController;
import calendar.model.CalendarManager;
import org.junit.Before;
import org.junit.Test;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertFalse;
import static org.junit.Assert.assertTrue;

/**
 * Integration tests for the CalendarController class validating command parsing and execution.
 * This test suite verifies the complete command-line interface functionality of the calendar
 * application through the CalendarController. Tests cover command parsing, syntax validation,
 * error handling, and integration with the underlying CalendarManager.
 * Key test areas include:
 * - Event creation commands (single, all-day, and recurring events)
 * - Event modification and editing operations
 * - Calendar management (create, edit, switch between calendars)
 * - Query operations (print events, show availability status)
 * - Event copying across calendars with timezone handling
 * - Command syntax validation and error reporting
 * - Multi-calendar isolation and context switching
 * The tests validate both successful operations and error conditions, ensuring that
 * the controller provides clear feedback for invalid commands and maintains proper
 * state across calendar operations. Special attention is given to timezone handling
 * and cross-calendar operations.
 */
public class CalendarControllerTest {

  private CalendarController controller;

  @Before
  public void setUp() {
    CalendarManager manager = new CalendarManager("Default");
    controller = new CalendarController(manager);
  }

  @Test
  public void handleCreateSingleEvent_correctSyntax_returnsConfirmation() {
    String cmd = "create event TeamMeeting from 2025-06-12T14:00 to 2025-06-12T16:00";
    String result = controller.handleCommand(cmd);
    assertEquals("Event created: TeamMeeting", result);
  }

  @Test
  public void handleCreateAllDayEvent_correctSyntax_returnsConfirmation() {
    String cmd = "create event OfficeParty on 2025-07-04";
    String result = controller.handleCommand(cmd);
    assertEquals("Event created: OfficeParty", result);
  }

  @Test
  public void handleCreateRecurring_forCount_returnsConfirmation() {
    String cmd = "create event SoccerGame from 2025-08-03T09:00 to 2025-08-03T10:00 repeats " +
        "MW for 2";
    String result = controller.handleCommand(cmd);
    assertEquals("Recurring series created: SoccerGame", result);
  }

  @Test
  public void handlePrintOnDate_whenNoEvents_returnsNoEventsMessage() {
    String cmd = "print events on 2025-09-01";
    String output = controller.handleCommand(cmd);
    assertTrue(output.contains("No events on this date."));
  }

  @Test
  public void handlePrintOnDate_withEvents_returnsList() {
    controller.handleCommand("create event Meeting on 2025-09-01");
    String output = controller.handleCommand("print events on 2025-09-01");
    assertTrue(output.contains("• Meeting"));
    assertTrue(output.contains("2025-09-01T08:00"));
  }

  @Test
  public void handleShowStatus_whenBusyOrAvailable() {
    controller.handleCommand("create event Call from 2025-10-05T14:00 to 2025-10-05T15:00");
    String busy = controller.handleCommand("show status on 2025-10-05T14:30");
    String avail = controller.handleCommand("show status on 2025-10-05T15:30");
    assertEquals("Busy", busy);
    assertEquals("Available", avail);
  }

  @Test
  public void handleEditEvent_changeSubject_updatesSuccessfully() {
    controller.handleCommand("create event Lunch on 2025-11-01");
    String editCmd =
        "edit event subject Lunch from 2025-11-01T08:00 to 2025-11-01T17:00 with Brunch";
    String result = controller.handleCommand(editCmd);
    assertEquals("Event edited: Lunch", result);

    String print = controller.handleCommand("print events on 2025-11-01");
    assertTrue(print.contains("Brunch"));
  }

  @Test
  public void handleEditEvent_badDateFormat_returnsFriendlyError() {
    String result = controller.handleCommand(
        "edit event subject Meeting from 2025-12-01 10:00 to 2025-12-01T11:00 with Sync"
    );
    assertTrue(result.contains("Invalid date/time format"));
  }

  @Test
  public void handleUnknownVerb_returnsErrorSuggestion() {
    String result = controller.handleCommand("foobar event on 2025-12-12");
    assertTrue(result.contains("Unknown command"));
    assertTrue(result.contains("Valid verbs: create, edit, print, show, exit."));
  }

  @Test
  public void handleEmptyOrWhitespace_returnsPromptError() {
    assertEquals(
        "Empty command—please type something or 'exit' to quit.",
        controller.handleCommand("   ")
    );
    assertEquals(
        "Empty command—please type something or 'exit' to quit.",
        controller.handleCommand("")
    );
  }

  @Test
  public void handleInvalidCreateSyntax_returnsDetailedUsage() {
    String result = controller.handleCommand("create nonsense");
    assertTrue(result.contains("Invalid create syntax."));
    assertTrue(result.contains("Expected: create event <subject> on|from"));
  }

  @Test
  public void handleInvalidPrintSyntax_returnsDetailedUsage() {
    String result = controller.handleCommand("print events at 2025-01-01");
    assertTrue(result.contains("Invalid print-events syntax."));
    assertTrue(result.contains("print events on YYYY-MM-DD"));
  }

  @Test
  public void handleInvalidShowSyntax_returnsDetailedUsage() {
    String result = controller.handleCommand("show status in 2025-01-01T10:00");
    assertTrue(result.contains("Invalid show-status syntax."));
    assertTrue(result.contains("show status on YYYY-MM-DDThh:mm"));
  }

  @Test
  public void handleInvalidEditSyntax_returnsDetailedUsage() {
    String result = controller.handleCommand("edit foo bar");
    assertTrue(result.contains("Invalid edit syntax."));
  }

  @Test
  public void handleExitOrQ_returnsExitToken() {
    assertEquals("exit", controller.handleCommand("exit"));
    assertEquals("exit", controller.handleCommand("q"));
    assertEquals("exit", controller.handleCommand("quit"));
  }

  @Test
  public void handleCreateCalendar_correctSyntax_returnsConfirmation() {
    String out = controller.handleCommand(
        "create calendar --name Work --timezone America/New_York"
    );
    assertEquals("Calendar created: Work", out);
  }

  @Test
  public void handleEditCalendar_changeName_returnsConfirmation() {
    controller.handleCommand("create calendar --name Home --timezone Europe/London");
    String out = controller.handleCommand(
        "edit calendar --name Home --property name Personal"
    );
    assertEquals("Calendar updated: Personal", out);

    // now confirm we can use it
    out = controller.handleCommand("use calendar --name Personal");
    assertEquals("Using calendar: Personal", out);
  }

  @Test
  public void handleUseCalendar_switchContext_affectsEvents() {
    controller.handleCommand("create calendar --name C1 --timezone UTC");
    controller.handleCommand("create calendar --name C2 --timezone UTC");

    // on C1
    controller.handleCommand("use calendar --name C1");
    controller.handleCommand("create event A on 2025-01-01");
    // on C2
    controller.handleCommand("use calendar --name C2");
    controller.handleCommand("create event B on 2025-01-01");
    // back to C1
    controller.handleCommand("use calendar --name C1");
    String out = controller.handleCommand("print events on 2025-01-01");
    assertTrue(out.contains("• A"));
    assertFalse(out.contains("B"));
  }

  @Test
  public void createCalendar_valid_returnsConfirmation() {
    String result = controller.handleCommand(
        "create calendar --name Work --timezone Europe/Paris"
    );
    assertEquals("Calendar created: Work", result);
  }

  @Test
  public void createCalendar_duplicateName_returnsError() {
    controller.handleCommand("create calendar --name HR --timezone UTC");
    String result = controller.handleCommand(
        "create calendar --name HR --timezone UTC"
    );
    assertTrue(result.contains("Calendar already exists"));
  }

  @Test
  public void useCalendar_switchesContext() {
    controller.handleCommand("create calendar --name Dept --timezone UTC");
    String use = controller.handleCommand("use calendar --name Dept");
    assertEquals("Using calendar: Dept", use);

    // now create an event in Dept and verify it only shows up there
    controller.handleCommand("create event A on 2025-12-01");
    // switch back to Default
    controller.handleCommand("use calendar --name Default");
    String defaultPrint = controller.handleCommand("print events on 2025-12-01");
    assertTrue(defaultPrint.contains("No events on this date."));
  }

  @Test
  public void editCalendar_changeTimezone_returnsConfirmation() {
    controller.handleCommand("create calendar --name Team --timezone UTC");
    String result = controller.handleCommand(
        "edit calendar --name Team --property timezone Asia/Kolkata"
    );
    assertEquals("Calendar updated: Team", result);
  }

  @Test
  public void copySingleEvent_acrossCalendars_copiesCorrectly() {
    controller.handleCommand("create calendar --name Src --timezone UTC");
    controller.handleCommand("create calendar --name Dst --timezone UTC");
    controller.handleCommand("use calendar --name Src");
    controller.handleCommand(
        "create event Meeting from 2025-02-10T10:00 to 2025-02-10T11:00"
    );

    String copy = controller.handleCommand(
        "copy event Meeting on 2025-02-10T10:00 --target Dst to 2025-03-01T09:00"
    );
    assertEquals("Event copied: Meeting → Dst", copy);

    controller.handleCommand("use calendar --name Dst");
    String out = controller.handleCommand("print events on 2025-03-01");
    assertTrue(out.contains("• Meeting"));
    assertTrue(out.contains("2025-03-01T09:00"));
  }

  @Test
  public void copyEventsOnDate_respectsTimezoneShift() {
    controller.handleCommand("create calendar --name EST --timezone America/New_York");
    controller.handleCommand("create calendar --name PST --timezone America/Los_Angeles");
    controller.handleCommand("use calendar --name EST");
    // default all‐day on 2025‑04‑01 becomes 08:00–17:00 EST
    controller.handleCommand("create event Lunch on 2025-04-01");

    String copy = controller.handleCommand(
        "copy events on 2025-04-01 --target PST to 2025-04-02"
    );
    assertEquals("Events copied on 2025-04-01 → PST", copy);

    controller.handleCommand("use calendar --name PST");
    // 08:00 EST is 05:00 PST
    String out = controller.handleCommand("print events on 2025-04-02");
    assertTrue(out.contains("2025-04-02T05:00"));
  }

  @Test
  public void copyEventsBetween_partialSeries_copiesOnlyInRange() {
    controller.handleCommand("create calendar --name A --timezone UTC");
    controller.handleCommand("create calendar --name B --timezone UTC");
    controller.handleCommand("use calendar --name A");
    controller.handleCommand(
        "create event Yoga from 2025-05-01T07:00 to 2025-05-01T08:00 repeats MW for 5"
    );

    String copy = controller.handleCommand(
        "copy events between 2025-05-03 and 2025-05-07 --target B to 2025-06-01"
    );
    assertEquals(
        "Events copied between 2025-05-03 and 2025-05-07 → B",
        copy
    );

    controller.handleCommand("use calendar --name B");
    String out = controller.handleCommand(
        "print events from 2025-06-01T07:00 to 2025-06-07T23:59"
    );
    // Should see only those days that fell on Wed/Mon in the original window
    assertTrue(out.contains("Yoga"));
  }
}
