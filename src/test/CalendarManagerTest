  @Test
  public void copyEventsOnDate_multiple_respectsSameWallClock() {
    mgr.createCalendar("A", "UTC");
    mgr.createCalendar("B", "UTC");
    mgr.useCalendar("A");
    // two events on 2025‑04‑01 at 08:00 and 12:00
    LocalDateTime a1 = LocalDateTime.of(2025,4,1,8,0);
    LocalDateTime a2 = LocalDateTime.of(2025,4,1,9,0);
    mgr.addEvent("M1", a1, a2, null,null,"public");
    LocalDateTime b1 = LocalDateTime.of(2025,4,1,12,0);
    LocalDateTime b2 = LocalDateTime.of(2025,4,1,13,0);
    mgr.addEvent("M2", b1, b2, null,null,"public");

    mgr.copyEventsOnDate(
        LocalDate.of(2025,4,1).atStartOfDay(),
        "B",
        LocalDate.of(2025,4,2).atStartOfDay()
    );
    mgr.useCalendar("B");
    List<Event> evs = mgr.getEventsOnDate(LocalDate.of(2025,4,2));
    assertEquals(2, evs.size());
    // both start at the same hour/minute as original
    assertTrue(evs.stream().anyMatch(e -> e.getStart().getHour() == 8));
    assertTrue(evs.stream().anyMatch(e -> e.getStart().getHour() == 12));
  }

  @Test
  public void copyEventsBetween_shiftsRelativeOffsets() {
    mgr.createCalendar("X", "UTC");
    mgr.createCalendar("Y", "UTC");
    mgr.useCalendar("X");
    // events on 2025-05-05 10:00 and 2025-05-06 14:00
    mgr.addEvent("E1",
        LocalDateTime.of(2025, 5, 5, 10, 0),
        LocalDateTime.of(2025, 5, 5, 11, 0),
        null, null, "public"
    );
    mgr.addEvent("E2",
        LocalDateTime.of(2025, 5, 6, 14, 0),
        LocalDateTime.of(2025, 5, 6, 15, 0),
        null, null, "public"
    );

    // copy window May 5–6 (inclusive) to start at June 1 09:00
    mgr.copyEventsBetween(
        LocalDateTime.of(2025, 5, 5, 0, 0),
        LocalDateTime.of(2025, 5, 6, 23, 59),
        "Y",
        LocalDateTime.of(2025, 6, 1, 9, 0)
    );
    mgr.useCalendar("Y");

    // E1 shifts to June 1 → should appear on June 1
    List<Event> june1 = mgr.getEventsOnDate(LocalDate.of(2025, 6, 1));
    assertTrue(june1.stream().anyMatch(e -> e.getSubject().equals("E1")));

    // E2 shifts to June 2 → should appear on June 2
    List<Event> june2 = mgr.getEventsOnDate(LocalDate.of(2025, 6, 2));
    assertTrue(june2.stream().anyMatch(e -> e.getSubject().equals("E2")));
  }

