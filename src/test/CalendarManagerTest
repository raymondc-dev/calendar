  @Test
  public void copyEvent_differentTimezones_convertsCorrectly() {
    // Create source calendar in EST
    mgr.createCalendar("Source", "America/New_York");
    mgr.useCalendar("Source");

    // Add event at 2 PM EST
    LocalDateTime sourceTime = LocalDateTime.of(2025, 6, 15, 14, 0);
    mgr.addEvent("Meeting", sourceTime, sourceTime.plusHours(1), "Important", "Office", "public");

    // Create target calendar in PST (3 hours behind EST)
    mgr.createCalendar("Target", "America/Los_Angeles");

    // Copy event to target calendar at same "wall clock" time
    LocalDateTime targetTime = LocalDateTime.of(2025, 6, 16, 14, 0);
    mgr.copyEvent("Meeting", sourceTime, "Target", targetTime);

    // Verify event was copied with correct details
    mgr.useCalendar("Target");
    List<Event> events = mgr.getEventsOnDate(LocalDate.of(2025, 6, 16));
    assertEquals(1, events.size());

    Event copied = events.get(0);
    assertEquals("Meeting", copied.getSubject());
    assertEquals(targetTime, copied.getStart());
    assertEquals(targetTime.plusHours(1), copied.getEnd());
    assertEquals("Important", copied.getDescription());
    assertEquals("Office", copied.getLocation());
  }

  @Test
  public void copyEventsBetween_differentTimezones_preservesRelativeTiming() {
    // Setup source calendar in UTC
    mgr.useCalendar("Default"); // Already UTC

    // Add events on consecutive days
    LocalDateTime day1 = LocalDateTime.of(2025, 6, 15, 10, 0); // 10 AM UTC
    LocalDateTime day2 = LocalDateTime.of(2025, 6, 16, 15, 0); // 3 PM UTC
    mgr.addEvent("Morning", day1, day1.plusHours(1), null, null, "public");
    mgr.addEvent("Afternoon", day2, day2.plusHours(2), null, null, "public");

    // Create target calendar in different timezone (JST = UTC+9)
    mgr.createCalendar("Japan", "Asia/Tokyo");

    // Copy 2-day range to target calendar
    mgr.copyEventsBetween(
        LocalDateTime.of(2025, 6, 15, 0, 0),    // From start of June 15
        LocalDateTime.of(2025, 6, 16, 23, 59),  // To end of June 16
        "Japan",
        LocalDateTime.of(2025, 7, 1, 0, 0)      // Target: July 1
    );

    // Verify events copied with correct time shifts
    mgr.useCalendar("Japan");

    // Check July 1st events (from June 15 source)
    List<Event> july1Events = mgr.getEventsOnDate(LocalDate.of(2025, 7, 1));
    assertEquals(1, july1Events.size());
    assertEquals("Morning", july1Events.get(0).getSubject());
    assertEquals(10, july1Events.get(0).getStart().getHour()); // Should maintain relative hour

    // Check July 2nd events (from June 16 source)
    List<Event> july2Events = mgr.getEventsOnDate(LocalDate.of(2025, 7, 2));
    assertEquals(1, july2Events.size());
    assertEquals("Afternoon", july2Events.get(0).getSubject());
    assertEquals(15, july2Events.get(0).getStart().getHour()); // Should maintain relative hour
  }

