  }

  @Test
  public void copyEvent_toOtherCalendar() {
    // in Default
    LocalDateTime srcStart = LocalDateTime.of(2025,2,10,10,0);
    LocalDateTime srcEnd   = srcStart.plusHours(1);
    mgr.addEvent("Meeting", srcStart, srcEnd, "Desc", "Loc", "public");

    // create a target
    mgr.createCalendar("Dst", "UTC");

    // copy it
    LocalDateTime dstStart = LocalDateTime.of(2025,3,1,9,0);
    mgr.copyEvent("Meeting", srcStart, "Dst", dstStart);

    // verify in Dst
    mgr.useCalendar("Dst");
    List<Event> out = mgr.getEventsOnDate(LocalDate.of(2025,3,1));
    assertEquals(1, out.size());
    Event e = out.get(0);
    assertEquals("Meeting",        e.getSubject());
    assertEquals(dstStart,         e.getStart());
    assertEquals(dstStart.plusHours(1), e.getEnd());
    assertEquals("Desc",           e.getDescription());
    assertEquals("Loc",            e.getLocation());
    assertEquals("public",         e.getStatus());
  }

