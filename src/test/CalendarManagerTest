  @Test
  public void copyEventsOnDate_toOtherCalendar() {
    // set up events on Jan 1
    LocalDateTime t1 = LocalDateTime.of(2025,1,1,8,0);
    LocalDateTime t2 = LocalDateTime.of(2025,1,1,12,0);
    mgr.addEvent("A", t1, t1.plusHours(1), null, null, "public");
    mgr.addEvent("B", t2, t2.plusHours(2), null, null, "public");

    mgr.createCalendar("Dst", "UTC");
    // copy all Jan 1 events to Feb 1 start of day
    mgr.copyEventsOnDate(
        LocalDateTime.of(2025,1,1,0,0),
        "Dst",
        LocalDateTime.of(2025,2,1,0,0)
    );

    mgr.useCalendar("Dst");
    List<Event> out = mgr.getEventsOnDate(LocalDate.of(2025,2,1));
    assertEquals(2, out.size());
    // check that times were preserved
    assertTrue(out.stream().anyMatch(e -> e.getSubject().equals("A") && e.getStart().getHour()
        == 8));
    assertTrue(out.stream().anyMatch(e -> e.getSubject().equals("B") && e.getStart().getHour()
        == 12));
  }

  @Test
  public void copyEventsBetween_toOtherCalendar() {
    // make three events on Jan 1–3
    LocalDateTime e1 = LocalDateTime.of(2025,1,1,9,0);
    LocalDateTime e2 = LocalDateTime.of(2025,1,2,9,0);
    LocalDateTime e3 = LocalDateTime.of(2025,1,3,9,0);
    mgr.addEvent("X1", e1, e1.plusHours(1), null, null, "public");
    mgr.addEvent("X2", e2, e2.plusHours(1), null, null, "public");
    mgr.addEvent("X3", e3, e3.plusHours(1), null, null, "public");

    mgr.createCalendar("Dst", "UTC");
    // copy only Jan 2–2 (so only X2) into Mar 1 at midnight
    mgr.copyEventsBetween(
        LocalDateTime.of(2025,1,2,0,0),
        LocalDateTime.of(2025,1,2,23,59),
        "Dst",
        LocalDateTime.of(2025,3,1,0,0)
    );

    mgr.useCalendar("Dst");
    List<Event> out = mgr.getEventsOnDate(LocalDate.of(2025,3,1));
    assertEquals(1, out.size());
    Event e = out.get(0);
    assertEquals("X2", e.getSubject());
    // original was 9:00, so after shift still 9:00
    assertEquals(9, e.getStart().getHour());
  }

