  @Test
  public void useCalendar_andIsolation() {
    // create a second calendar
    mgr.createCalendar("B", "UTC");
    // in Default, add E1
    LocalDateTime dt = LocalDateTime.of(2025,1,1,9,0);
    mgr.addEvent("E1", dt, dt.plusHours(1), null, null, "public");

    // switch to B and add E2
    mgr.useCalendar("B");
    mgr.addEvent("E2", dt, dt.plusHours(2), null, null, "public");

    // back to Default: should see only E1
    mgr.useCalendar("Default");
    List<Event> defaultEvents = mgr.getEventsOnDate(LocalDate.of(2025,1,1));
    assertEquals(1, defaultEvents.size());
    assertEquals("E1", defaultEvents.get(0).getSubject());

    // in B we see only E2
    mgr.useCalendar("B");
    List<Event> bEvents = mgr.getEventsOnDate(LocalDate.of(2025,1,1));
    assertEquals(1, bEvents.size());
    assertEquals("E2", bEvents.get(0).getSubject());
  }

  @Test(expected = IllegalArgumentException.class)
