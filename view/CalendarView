package calendar.view;

import calendar.controller.CalendarController;

import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;
import java.io.InputStreamReader;

/**
 * Text-based UI for the calendar application in interactive or headless mode.
 */
public class CalendarView {
  private final CalendarController controller;
  private final boolean interactive;
  private final String scriptFile;

  /**
   * Construct a CalendarView.
   *
   * @param controller   controller to handle commands
   * @param interactive  true → interactive mode; false → headless
   * @param scriptFile   script filename for headless mode (nullable otherwise)
   */
  public CalendarView(
      CalendarController controller,
      boolean interactive,
      String scriptFile
  ) {
    this.controller = controller;
    this.interactive = interactive;
    this.scriptFile = scriptFile;
  }

  /**
   * Start the view: either interactive prompt or headless file processing.
   */
  public void start() {
    if (interactive) {
      runInteractive();
    } else {
      runHeadless(scriptFile);
    }
  }

  // Run interactive loop, quitting on exit/quit/q.
  private void runInteractive() {
    System.out.println("=== Calendar Interactive Mode ===");
    System.out.println("Enter commands (type \"exit\", \"quit\", or \"q\" to quit):");

    try (BufferedReader reader =
             new BufferedReader(new InputStreamReader(System.in))) {
      String line;
      while (true) {
        System.out.print("> ");
        line = reader.readLine();
        if (line == null) {
          break;
        }
        String trimmed = line.trim();
        if (trimmed.equalsIgnoreCase("exit")
            || trimmed.equalsIgnoreCase("quit")
            || trimmed.equalsIgnoreCase("q")) {
          break;
        }
        if (trimmed.isEmpty()) {
          continue;
        }

        String output = controller.handleCommand(trimmed);
        if (output != null && output.equals("exit")) {
          break;
        }
        if (output != null && !output.isEmpty() && !output.equals("exit")) {
          System.out.println(output);
        }

        if (trimmed.startsWith("create calendar")) {
          System.out.println(controller.handleCommand(trimmed));
          continue;
        }
        if (trimmed.startsWith("use calendar")) {
          System.out.println(controller.handleCommand(trimmed));
          continue;
        }
        if (trimmed.startsWith("copy ")) {
          System.out.println(controller.handleCommand(trimmed));
          continue;
        }
      }
    } catch (IOException ioe) {
      System.out.println("I/O error: " + ioe.getMessage());
    }

    System.out.println("Exiting interactive mode.");
  }

  // Run headless mode, reading commands from file, quitting on exit.
  private void runHeadless(String filename) {
    System.out.println("=== Calendar Headless Mode ===");
    boolean sawExit = false;

    try (BufferedReader fileReader = new BufferedReader(new FileReader(filename))) {
      String line;
      while ((line = fileReader.readLine()) != null) {
        String trimmed = line.trim();
        if (trimmed.isEmpty()) {
          continue;
        }

        System.out.println("> " + trimmed);
        if (trimmed.equalsIgnoreCase("exit")) {
          sawExit = true;
          break;
        }

        String output = controller.handleCommand(trimmed);
        if (output != null && output.equals("exit")) {
          sawExit = true;
          break;
        }
        if (output != null && !output.isEmpty()) {
          System.out.println(output);
        }
        if (trimmed.startsWith("create calendar")) {
          System.out.println(controller.handleCommand(trimmed));
          continue;
        }
        if (trimmed.startsWith("use calendar")) {
          System.out.println(controller.handleCommand(trimmed));
          continue;
        }
        if (trimmed.startsWith("copy ")) {
          System.out.println(controller.handleCommand(trimmed));
          continue;
        }
      }

      if (!sawExit) {
        System.out.println("Error: No exit command found in the file.");
      }
    } catch (IOException ioe) {
      System.out.println("I/O error reading file: " + ioe.getMessage());
    }

    System.out.println("Exiting headless mode.");
  }
}
