package calendar.view;

import calendar.controller.CalendarController;
import calendar.model.Event;

import javax.swing.BorderFactory;
import javax.swing.BoxLayout;
import javax.swing.DefaultListCellRenderer;
import javax.swing.DefaultListModel;
import javax.swing.JButton;
import javax.swing.JComboBox;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JList;
import javax.swing.JOptionPane;
import javax.swing.JPanel;
import javax.swing.JScrollPane;
import javax.swing.JTextField;
import javax.swing.ListSelectionModel;
import javax.swing.border.TitledBorder;

import java.awt.BorderLayout;
import java.awt.Component;
import java.awt.FlowLayout;
import java.awt.GridBagConstraints;
import java.awt.GridBagLayout;
import java.awt.Insets;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.time.format.DateTimeParseException;
import java.util.List;
import java.util.Set;

/**
 * Compact GUI implementation with all features including extra credit.
 * - Multiple calendar support with switching and creation
 * - Event editing and deletion capabilities
 * - Complete CRUD operations in under 700 lines
 */
public class CalendarGUI extends JFrame {
  private final CalendarController controller;
  private final DateTimeFormatter dateFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd");
  private final DateTimeFormatter timeFormatter = DateTimeFormatter.ofPattern("HH:mm");

  // Core components
  private JComboBox<String> calendarCombo;
  private JComboBox<String> timezoneCombo;
  private JComboBox<String> statusCombo;
  private JTextField dateField;
  private JTextField newCalendarField;
  private JList<Event> eventList;
  private DefaultListModel<Event> eventListModel;
  private JTextField subjectField;
  private JTextField startDateField;
  private JTextField startTimeField;
  private JTextField endDateField;
  private JTextField endTimeField;
  private JTextField descriptionField;
  private JTextField locationField;
  private JButton createEditButton;
  private JButton cancelEditButton;
  private JLabel statusLabel;

  // State management
  private Event selectedEvent = null;
  private boolean isEditMode = false;

  public CalendarGUI(CalendarController controller) {
    this.controller = controller;
    initializeGUI();
  }

  public void start() {
    setVisible(true);
    loadEventsForCurrentDate();
  }

  private void initializeGUI() {
    setTitle("Calendar Application - Enhanced");
    setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
    setSize(900, 700);
    setLocationRelativeTo(null);
    setLayout(new BorderLayout());

    add(createCalendarPanel(), BorderLayout.NORTH);
    add(createMainPanel(), BorderLayout.CENTER);
    add(createEventFormPanel(), BorderLayout.SOUTH);

    statusLabel = new JLabel("Ready - Default calendar active");
    statusLabel.setBorder(BorderFactory.createLoweredBevelBorder());
    add(statusLabel, BorderLayout.PAGE_END);
  }

  private JPanel createCalendarPanel() {
    JPanel panel = new JPanel();
    panel.setLayout(new BoxLayout(panel, BoxLayout.Y_AXIS));
    panel.setBorder(new TitledBorder("Calendar Management"));

    JPanel currentPanel = new JPanel(new FlowLayout(FlowLayout.LEFT));
    currentPanel.add(new JLabel("Current:"));
    calendarCombo = new JComboBox<>();
    refreshCalendarList();
    calendarCombo.addActionListener(e -> switchCalendar());
    currentPanel.add(calendarCombo);
    panel.add(currentPanel);

    JPanel newPanel = new JPanel(new FlowLayout(FlowLayout.LEFT));
    newPanel.add(new JLabel("Create:"));
    newCalendarField = new JTextField(12);
    newPanel.add(newCalendarField);

    timezoneCombo = new JComboBox<>(new String[]{
        "America/New_York",
        "America/Chicago",
        "America/Denver",
        "America/Los_Angeles",
        "Europe/London",
        "Europe/Paris",
        "Asia/Tokyo",
        "Asia/Shanghai"
    });
    newPanel.add(timezoneCombo);

    JButton createCalButton = new JButton("Create Calendar");
    createCalButton.addActionListener(this::createCalendar);
    newPanel.add(createCalButton);
    panel.add(newPanel);

    return panel;
  }

  private JPanel createMainPanel() {
    JPanel panel = new JPanel(new BorderLayout());

    // Date navigation
    JPanel datePanel = new JPanel(new FlowLayout());
    datePanel.setBorder(new TitledBorder("Date Navigation"));
    datePanel.add(new JLabel("Date:"));
    dateField = new JTextField(LocalDate.now().format(dateFormatter), 10);
    datePanel.add(dateField);

    String[] navButtons = {"Prev", "Today", "Next", "Refresh"};
    ActionListener[] navActions = {
        e -> navigateDate(-1), e -> goToToday(),
        e -> navigateDate(1), e -> loadEventsForCurrentDate()
    };
    for (int i = 0; i < navButtons.length; i++) {
      JButton btn = new JButton(navButtons[i]);
      btn.addActionListener(navActions[i]);
      datePanel.add(btn);
    }
    panel.add(datePanel, BorderLayout.NORTH);

    // Event list with management buttons
    JPanel eventPanel = new JPanel(new BorderLayout());
    eventPanel.setBorder(new TitledBorder("Events"));

    eventListModel = new DefaultListModel<>();
    eventList = new JList<>(eventListModel);
    eventList.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);
    eventList.setCellRenderer(new EventRenderer());
    eventList.addListSelectionListener(e -> {
      if (!e.getValueIsAdjusting() && eventList.getSelectedValue() != null) {
        populateFormForEditing(eventList.getSelectedValue());
      }
    });

    eventPanel.add(new JScrollPane(eventList), BorderLayout.CENTER);

    JPanel eventButtons = new JPanel(new FlowLayout());
    JButton editBtn = new JButton("Edit Selected");
    editBtn.addActionListener(e -> startEditMode());
    JButton deleteBtn = new JButton("Delete Selected");
    deleteBtn.addActionListener(e -> deleteSelectedEvent());
    eventButtons.add(editBtn);
    eventButtons.add(deleteBtn);
    eventPanel.add(eventButtons, BorderLayout.SOUTH);

    panel.add(eventPanel, BorderLayout.CENTER);
    return panel;
  }

  private JPanel createEventFormPanel() {
    JPanel panel = new JPanel(new BorderLayout());
    panel.setBorder(new TitledBorder("Create/Edit Event"));

    JPanel formPanel = new JPanel(new GridBagLayout());
    GridBagConstraints gbc = new GridBagConstraints();
    gbc.insets = new Insets(3, 3, 3, 3);
    gbc.anchor = GridBagConstraints.WEST;

    // Form fields with compact layout
    Object[][] fields = {
        {"Subject:", subjectField = new JTextField(20)},
        {"Start Date:", startDateField = new JTextField(LocalDate.now().format(dateFormatter), 10)},
        {"Start Time:", startTimeField = new JTextField("09:00", 5)},
        {"End Date:", endDateField = new JTextField(LocalDate.now().format(dateFormatter), 10)},
        {"End Time:", endTimeField = new JTextField("10:00", 5)},
        {"Description:", descriptionField = new JTextField(20)},
        {"Location:", locationField = new JTextField(20)},
        {"Status:", statusCombo = new JComboBox<>(new String[]{"public", "private"})}
    };

    for (int i = 0; i < fields.length; i++) {
      gbc.gridx = 0;
      gbc.gridy = i;
      gbc.fill = GridBagConstraints.NONE;
      gbc.weightx = 0;
      formPanel.add(new JLabel((String)fields[i][0]), gbc);
      gbc.gridx = 1;
      gbc.fill = GridBagConstraints.HORIZONTAL;
      gbc.weightx = 1.0;
      formPanel.add((Component)fields[i][1], gbc);
    }

    panel.add(formPanel, BorderLayout.CENTER);

    // Form buttons
    JPanel buttonPanel = new JPanel(new FlowLayout());
    createEditButton = new JButton("Create Event");
    createEditButton.addActionListener(this::createOrEditEvent);
    cancelEditButton = new JButton("Cancel Edit");
    cancelEditButton.addActionListener(e -> exitEditMode());
    cancelEditButton.setVisible(false);

    buttonPanel.add(createEditButton);
    buttonPanel.add(cancelEditButton);
    buttonPanel.add(createButton("Clear Form", e -> clearForm()));
    panel.add(buttonPanel, BorderLayout.SOUTH);

    return panel;
  }

  // Helper method to create buttons with actions
  private JButton createButton(String text, ActionListener action) {
    JButton button = new JButton(text);
    button.addActionListener(action);
    return button;
  }

  // Calendar management methods
  private void refreshCalendarList() {
    calendarCombo.removeAllItems();
    Set<String> calendars = controller.getManager().listCalendars();
    calendars.forEach(calendarCombo::addItem);
  }

  private void switchCalendar() {
    String selected = (String) calendarCombo.getSelectedItem();
    if (selected != null) {
      try {
        controller.getManager().useCalendar(selected);
        setStatus("Switched to calendar: " + selected);
        loadEventsForCurrentDate();
        exitEditMode();
      } catch (Exception e) {
        showError("Error switching calendar: " + e.getMessage());
      }
    }
  }

  private void createCalendar(ActionEvent e) {
    try {
      String name = newCalendarField.getText().trim();
      if (name.isEmpty()) {
        showError("Calendar name is required.");
        return;
      }
      String timezone = (String) timezoneCombo.getSelectedItem();
      controller.getManager().createCalendar(name, timezone);
      showSuccess("Calendar created: " + name);
      refreshCalendarList();
      calendarCombo.setSelectedItem(name);
      newCalendarField.setText("");
    } catch (Exception ex) {
      showError("Error creating calendar: " + ex.getMessage());
    }
  }

  // Navigation methods
  private void navigateDate(int days) {
    try {
      LocalDate current = LocalDate.parse(dateField.getText(), dateFormatter);
      dateField.setText(current.plusDays(days).format(dateFormatter));
      loadEventsForCurrentDate();
    } catch (Exception e) {
      showError("Invalid date format. Please use YYYY-MM-DD.");
    }
  }

  private void goToToday() {
    dateField.setText(LocalDate.now().format(dateFormatter));
    loadEventsForCurrentDate();
  }

  // Event management methods
  private void loadEventsForCurrentDate() {
    try {
      LocalDate date = LocalDate.parse(dateField.getText(), dateFormatter);
      List<Event> events = controller.getEventsOnDate(date);

      eventListModel.clear();
      int maxEvents = Math.min(events.size(), 10);
      for (int i = 0; i < maxEvents; i++) {
        eventListModel.addElement(events.get(i));
      }

      String statusMsg = events.isEmpty() ? "No events found" :
          "Loaded " + maxEvents + " events";
      if (events.size() > 10) {
        statusMsg += " (showing first 10)";
      }
      setStatus(statusMsg + " for " + date.format(dateFormatter));

    } catch (DateTimeParseException e) {
      showError("Invalid date format. Please use YYYY-MM-DD.");
    } catch (Exception e) {
      showError("Error loading events: " + e.getMessage());
    }
  }

  private void startEditMode() {
    Event selected = eventList.getSelectedValue();
    if (selected == null) {
      showError("Please select an event to edit.");
      return;
    }
    selectedEvent = selected;
    isEditMode = true;
    createEditButton.setText("Save Changes");
    cancelEditButton.setVisible(true);
    ((TitledBorder) ((JPanel) createEditButton.getParent().getParent()).getBorder())
        .setTitle("Edit Event");
    repaint();
    setStatus("Editing event: " + selected.getSubject());
  }

  private void exitEditMode() {
    selectedEvent = null;
    isEditMode = false;
    createEditButton.setText("Create Event");
    cancelEditButton.setVisible(false);
    ((TitledBorder) ((JPanel) createEditButton.getParent().getParent()).getBorder())
        .setTitle("Create/Edit Event");
    repaint();
    clearForm();
    eventList.clearSelection();
    setStatus("Exited edit mode");
  }

  private void populateFormForEditing(Event event) {
    if (isEditMode && event == selectedEvent) {
      return;
    }

    subjectField.setText(event.getSubject());
    if (event.getStart() != null) {
      startDateField.setText(event.getStart().toLocalDate().format(dateFormatter));
      startTimeField.setText(event.getStart().format(timeFormatter));
    }
    if (event.getEnd() != null) {
      endDateField.setText(event.getEnd().toLocalDate().format(dateFormatter));
      endTimeField.setText(event.getEnd().format(timeFormatter));
    }
    descriptionField.setText(event.getDescription() != null ? event.getDescription() : "");
    locationField.setText(event.getLocation() != null ? event.getLocation() : "");
    statusCombo.setSelectedItem(event.getStatus() != null ? event.getStatus() : "public");
  }

  private void deleteSelectedEvent() {
    Event selected = eventList.getSelectedValue();
    if (selected == null) {
      showError("Please select an event to delete.");
      return;
    }

    int result = JOptionPane.showConfirmDialog(this,
        "Delete event: " + selected.getSubject() + "?", "Confirm Delete",
        JOptionPane.YES_NO_OPTION, JOptionPane.WARNING_MESSAGE);

    if (result == JOptionPane.YES_OPTION) {
      try {
        controller.getManager().removeSingleEvent(selected);
        showSuccess("Event deleted: " + selected.getSubject());
        loadEventsForCurrentDate();
        exitEditMode();
      } catch (Exception e) {
        showError("Error deleting event: " + e.getMessage());
      }
    }
  }

  private void createOrEditEvent(ActionEvent e) {
    try {
      String subject = subjectField.getText().trim();
      if (subject.isEmpty()) {
        showError("Subject is required.");
        return;
      }

      LocalDate startDate = LocalDate.parse(startDateField.getText(), dateFormatter);
      LocalDate endDate = LocalDate.parse(endDateField.getText(), dateFormatter);

      LocalDateTime startDateTime = parseDateTime(startDate, startTimeField.getText().trim(), 8, 0);
      LocalDateTime endDateTime = parseDateTime(endDate, endTimeField.getText().trim(), 17, 0);

      if (endDateTime.isBefore(startDateTime)) {
        showError("End time must be after start time.");
        return;
      }

      String description = getTextOrNull(descriptionField);
      String location = getTextOrNull(locationField);
      String status = (String) statusCombo.getSelectedItem();

      if (isEditMode && selectedEvent != null) {
        controller.getManager().editSingleEvent(selectedEvent, subject,
            startDateTime, endDateTime, description, location, status);
        showSuccess("Event updated: " + subject);
        exitEditMode();
      } else {
        controller.createEvent(subject, startDateTime, endDateTime, description, location, status);
        showSuccess("Event created: " + subject);
        clearForm();
      }

      loadEventsForCurrentDate();

    } catch (DateTimeParseException ex) {
      showError("Invalid date/time format. Use YYYY-MM-DD for dates and HH:MM for times.");
    } catch (NumberFormatException ex) {
      showError("Invalid time format. Use HH:MM (e.g., 09:30).");
    } catch (Exception ex) {
      showError("Error with event: " + ex.getMessage());
    }
  }

  // Helper methods
  private LocalDateTime parseDateTime(LocalDate date, String timeText,
                                      int defaultHour, int defaultMin) {
    if (timeText.isEmpty()) {
      return date.atTime(defaultHour, defaultMin);
    }
    String[] parts = timeText.split(":");
    return date.atTime(Integer.parseInt(parts[0]), Integer.parseInt(parts[1]));
  }

  private String getTextOrNull(JTextField field) {
    String text = field.getText().trim();
    return text.isEmpty() ? null : text;
  }

  private void clearForm() {
    subjectField.setText("");
    LocalDate today = LocalDate.now();
    startDateField.setText(today.format(dateFormatter));
    endDateField.setText(today.format(dateFormatter));
    startTimeField.setText("09:00");
    endTimeField.setText("10:00");
    descriptionField.setText("");
    locationField.setText("");
    statusCombo.setSelectedIndex(0);
  }

  private void showError(String message) {
    JOptionPane.showMessageDialog(this, message, "Error", JOptionPane.ERROR_MESSAGE);
    setStatus("Error: " + message);
  }

  private void showSuccess(String message) {
    JOptionPane.showMessageDialog(this, message, "Success", JOptionPane.INFORMATION_MESSAGE);
    setStatus(message);
  }

  private void setStatus(String message) {
    statusLabel.setText(message);
  }

  // Custom renderer for event list
  private class EventRenderer extends DefaultListCellRenderer {
    @Override
    public Component getListCellRendererComponent(JList<?> list, Object value,
                                                  int index, boolean isSelected,
                                                  boolean cellHasFocus) {
      super.getListCellRendererComponent(list, value, index, isSelected, cellHasFocus);

      if (value instanceof Event) {
        Event event = (Event) value;
        StringBuilder sb = new StringBuilder(event.getSubject());
        if (event.getStart() != null) {
          sb.append(" | ").append(event.getStart().format(timeFormatter));
          if (event.getEnd() != null) {
            sb.append(" - ").append(event.getEnd().format(timeFormatter));
          }
        }
        if (event.getLocation() != null && !event.getLocation().trim().isEmpty()) {
          sb.append(" | ").append(event.getLocation());
        }
        setText(sb.toString());
      } else {
        setText("No events for this date");
      }
      return this;
    }
  }
}
